# API Key de Google Gemini (console.cloud.google.com → AI Studio)
GEMINI_API_KEY=AIza...

# URL de EJE CLOUD (Consejo de la Magistratura de la CABA)
EJE_CLOUD_URL=https://ejecloud.jusbaires.gob.ar

# Credenciales de acceso a EJE CLOUD
EJE_CLOUD_USER=usuario@jusbaires.gob.ar
EJE_CLOUD_PASSWORD=contraseña

# Modelo Gemini a usar
GEMINI_MODEL=gemini-2.0-flash

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Timeout del navegador (ms)
BROWSER_TIMEOUT=30000

# Modo headless del navegador (true = sin interfaz gráfica)
BROWSER_HEADLESS=true
