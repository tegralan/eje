# API Key de Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# URL de EJE CLOUD (Ciudad de Buenos Aires)
EJE_CLOUD_URL=https://ejecloud.buenosaires.gob.ar

# Credenciales de acceso a EJE CLOUD
EJE_CLOUD_USER=usuario@buenosaires.gob.ar
EJE_CLOUD_PASSWORD=contraseña

# Modelo Claude a usar
CLAUDE_MODEL=claude-sonnet-4-6

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Timeout del navegador (ms)
BROWSER_TIMEOUT=30000

# Modo headless del navegador (true = sin interfaz gráfica)
BROWSER_HEADLESS=true
